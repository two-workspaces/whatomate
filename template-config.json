{
 "services": {
  "d8995411-1141-4dea-9cae-5686f2535345": {
   "icon": "https://raw.githubusercontent.com/two-workspaces/whatomate/main/icon.svg",
   "name": "Whatomate",
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "repo": "https://github.com/two-workspaces/whatomate",
    "rootDirectory": null
   },
   "variables": {
    "PORT": {
     "defaultValue": "8080",
     "description": "Port Whatomate listens on; the Railway domain points here. Leave it at 8080.",
     "isOptional": false
    },
    "WHATOMATE_DEFAULT_ADMIN__EMAIL": {
     "defaultValue": "admin@example.com",
     "description": "Email of the first admin, created on the first boot. Change it to yours before deploying.",
     "isOptional": false
    },
    "WHATOMATE_DEFAULT_ADMIN__PASSWORD": {
     "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated password for the first admin; copy it from here to sign in.",
     "isOptional": false
    },
    "WHATOMATE_SERVER__PUBLIC_URL": {
     "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Address people open Whatomate at. Set it to your custom domain when you add one.",
     "isOptional": false
    },
    "WHATOMATE_WHATSAPP__WEBHOOK_VERIFY_TOKEN": {
     "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Verify token you paste into Meta's webhook settings, next to the callback URL https://YOUR-DOMAIN/api/webhook.",
     "isOptional": false
    },
    "WHATOMATE_JWT__SECRET": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Signs sign-in sessions. Generated; keep it secret.",
     "isOptional": false
    },
    "WHATOMATE_APP__ENCRYPTION_KEY": {
     "defaultValue": "${{secret(40, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Encrypts WhatsApp access tokens in the database. Generated; never change it once accounts are connected.",
     "isOptional": false
    },
    "WHATOMATE_DATABASE__HOST": {
     "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Postgres over the private network; leave as is.",
     "isOptional": false
    },
    "WHATOMATE_DATABASE__USER": {
     "defaultValue": "${{Postgres.POSTGRES_USER}}",
     "description": "Postgres user; leave as is.",
     "isOptional": false
    },
    "WHATOMATE_DATABASE__PASSWORD": {
     "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
     "description": "Postgres password; leave as is.",
     "isOptional": false
    },
    "WHATOMATE_DATABASE__NAME": {
     "defaultValue": "${{Postgres.POSTGRES_DB}}",
     "description": "Postgres database; leave as is.",
     "isOptional": false
    },
    "WHATOMATE_REDIS__HOST": {
     "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Redis over the private network, for the message queue and live updates; leave as is.",
     "isOptional": false
    },
    "WHATOMATE_REDIS__PASSWORD": {
     "defaultValue": "${{Redis.REDIS_PASSWORD}}",
     "description": "Redis password; leave as is.",
     "isOptional": false
    },
    "TZ": {
     "defaultValue": "UTC",
     "description": "Time zone for business hours in IVR and chatbot flows, for example Europe/London.",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {
     "<hasDomain>:8080": {
      "port": 8080
     }
    },
    "tcpProxies": {}
   },
   "volumeMounts": {
    "d8995411-1141-4dea-9cae-5686f2535345": {
     "mountPath": "/data"
    }
   }
  },
  "6ea1723e-8c95-4fc5-a90a-a500381f7d48": {
   "icon": "https://devicons.railway.app/i/postgresql.svg",
   "name": "Postgres",
   "deploy": {
    "startCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
   },
   "variables": {
    "POSTGRES_DB": {
     "defaultValue": "whatomate",
     "description": "Database name",
     "isOptional": false
    },
    "POSTGRES_USER": {
     "defaultValue": "whatomate",
     "description": "Database user",
     "isOptional": false
    },
    "POSTGRES_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated database password",
     "isOptional": false
    },
    "PGDATA": {
     "defaultValue": "/var/lib/postgresql/data/pgdata",
     "description": "Data subdirectory, which keeps Postgres happy on Railway volumes",
     "isOptional": false
    },
    "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
     "defaultValue": "60",
     "description": "Time for Postgres to shut down cleanly on redeploy",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {},
    "tcpProxies": {}
   },
   "volumeMounts": {
    "6ea1723e-8c95-4fc5-a90a-a500381f7d48": {
     "mountPath": "/var/lib/postgresql/data"
    }
   }
  },
  "4ed0e4bd-1952-4927-91f4-62def8840c0c": {
   "icon": "https://devicons.railway.app/i/redis.svg",
   "name": "Redis",
   "deploy": {
    "startCommand": "/bin/sh -c \"chown -R redis:redis /data && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --appendonly yes --maxmemory-policy noeviction\"",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "redis:8.10.3-alpine"
   },
   "variables": {
    "REDIS_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated Redis password",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {},
    "tcpProxies": {}
   },
   "volumeMounts": {
    "4ed0e4bd-1952-4927-91f4-62def8840c0c": {
     "mountPath": "/data"
    }
   }
  }
 }
}